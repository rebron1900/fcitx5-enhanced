<?xml version="1.0" encoding="utf-8"?>
<!-- iOS Inset Grouped 风格设置页：分区小标题 + 圆角卡片 + 44dp 行 + 分隔线 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <!-- ═══ 分区：外观 ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_appearance"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ios_secondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_blur_label"
                    android:textSize="16sp"
                    android:textColor="@color/ios_label" />
                <TextView
                    android:id="@+id/tv_blur_val"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/settings_blur_default"
                    android:textSize="16sp"
                    android:textColor="@color/ios_accent" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_blur_radius"
                android:contentDescription="@string/settings_blur_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_blur_desc"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_bg_opacity_label"
                    android:textSize="16sp"
                    android:textColor="@color/ios_label" />
                <TextView
                    android:id="@+id/tv_alpha_val"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/settings_bg_opacity_default"
                    android:textSize="16sp"
                    android:textColor="@color/ios_accent" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_bg_alpha"
                android:contentDescription="@string/settings_bg_opacity_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="60"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_bg_opacity_desc"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_key_opacity_label"
                    android:textSize="16sp"
                    android:textColor="@color/ios_label" />
                <TextView
                    android:id="@+id/tv_key_alpha_val"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/settings_key_opacity_default"
                    android:textSize="16sp"
                    android:textColor="@color/ios_accent" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_key_alpha"
                android:contentDescription="@string/settings_key_opacity_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="140"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_key_opacity_desc"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_corner_label"
                    android:textSize="16sp"
                    android:textColor="@color/ios_label" />
                <TextView
                    android:id="@+id/tv_corner_val"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/settings_corner_default"
                    android:textSize="16sp"
                    android:textColor="@color/ios_accent" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_corner_radius"
                android:contentDescription="@string/settings_corner_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48"
                android:progress="20"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_corner_desc"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp" />
        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/ios_separator" android:layout_marginStart="16dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_button_bottom_margin_label" android:textSize="16sp" android:textColor="@color/ios_label" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" />
        <TextView android:id="@+id/tv_button_bottom_margin_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_button_bottom_margin_default" android:textSize="16sp" android:textColor="@color/ios_accent" android:gravity="end" android:paddingStart="16dp" android:paddingEnd="16dp" />
        <SeekBar android:id="@+id/sb_button_bottom_margin" android:contentDescription="@string/settings_button_bottom_margin_accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="26" android:paddingStart="16dp" android:paddingEnd="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_button_bottom_margin_desc" android:textSize="13sp" android:textColor="@color/ios_secondary" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="10dp" />

        </LinearLayout>

        <!-- ═══ 分区：底部按钮 ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_toolbar"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ios_secondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_voice_label"
                        android:textSize="16sp"
                        android:textColor="@color/ios_label" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_voice_desc"
                        android:textSize="13sp"
                        android:textColor="@color/ios_secondary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/sw_voice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_ime_label"
                        android:textSize="16sp"
                        android:textColor="@color/ios_label" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_ime_desc"
                        android:textSize="13sp"
                        android:textColor="@color/ios_secondary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/sw_left_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator"
                android:layout_marginStart="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_clipboard_label"
                        android:textSize="16sp"
                        android:textColor="@color/ios_label" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_clipboard_desc"
                        android:textSize="13sp"
                        android:textColor="@color/ios_secondary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/sw_right_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ 分区：按键 ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_keys"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ios_secondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_border_label"
                        android:textSize="16sp"
                        android:textColor="@color/ios_label" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_border_desc"
                        android:textSize="13sp"
                        android:textColor="@color/ios_secondary" />
                </LinearLayout>
                <Switch
                    android:id="@+id/sw_key_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_live_note"
            android:textSize="13sp"
            android:textColor="@color/ios_secondary"
            android:gravity="center"
            android:layout_marginTop="24dp" />
    </LinearLayout>

</ScrollView>
